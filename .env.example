# Copy to .env. Never commit .env.
# BSS_ACCESS_SECRET: signs access codes and cookies. Must match the Pages secret.
#   Changing it invalidates every code already issued.
# DROP_CONTENT_KEY: decrypts the drop bundle. Must match the Pages secret.
#   Losing it means the drop can't be opened. Leaking it exposes the drop content.
BSS_ACCESS_SECRET=replace-with-a-long-random-string
DROP_CONTENT_KEY=replace-with-output-of-pack-drop-keygen
